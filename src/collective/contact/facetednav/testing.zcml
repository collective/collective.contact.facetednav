<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    i18n_domain="collective.contact.facetednav">

  <include file="configure.zcml" />

  <include package="ecreall.helpers.testing" />
  <!-- collective.contact.core @@add-contact (create contact link): z3c.autoinclude loads it on a site -->
  <include package="plone.formwidget.contenttree"
           zcml:condition="installed plone.formwidget.contenttree" />

  <genericsetup:registerProfile
      name="testing"
      title="collective.contact.facetednav tests"
      directory="profiles/testing"
      description="Steps to ease tests of collective.contact.facetednav"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

</configure>
