<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      i18n:domain="collective.contact.facetednav"
>

  <a tal:attributes="
       href view/url;
       class view/klass;
       id string:contact-action-${view/name}-${context/UID};
       onclick view/onclick|nothing;
     ">
    <img tal:attributes="
           src python:context.restrictedTraverse('@@iconresolver').url(view.icon);
           alt view/title;
           title view/title;
         "
         i18n:attributes="alt; title"
         i18n:domain="plone"
    />
  </a>

</html>
